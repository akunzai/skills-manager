{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentSkillsConfig",
  "description": "Configuration schema for managing global AI agent skills",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "settings": {
      "type": "object",
      "properties": {
        "defaultAgents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Agents selected by Follow defaults for Availability"
        },
		"availability": {
		  "type": "object",
		  "description": "Persistent per-skill agent availability overrides",
		  "additionalProperties": {
			"type": "object",
			"properties": {
			  "include": {
				"type": "array",
				"items": { "type": "string" },
				"uniqueItems": true
			  },
			  "exclude": {
				"type": "array",
				"items": { "type": "string" },
				"uniqueItems": true
			  }
			},
			"additionalProperties": false
		  }
		}
      },
      "additionalProperties": false
    },
    "remote": {
      "type": "object",
      "description": "Remote Git/GitHub skill repositories",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["github", "gitlab", "git"]
          },
          "url": {
            "type": "string",
            "description": "Optional custom Git clone URL"
          },
          "branch": {
            "type": "string",
            "description": "Optional branch or tag"
          },
          "skills": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map of skill name to its relative path within the repository"
          }
        },
        "required": ["skills"],
        "additionalProperties": false
      }
    },
    "local": {
      "type": "object",
      "description": "Locally managed skills (symlinks or CLI-installed tools)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["symlink", "command"]
          },
          "source": {
            "type": "string",
            "description": "Path to local skill directory (for symlink type)"
          },
          "check": {
            "type": "string",
            "description": "Command to check if tool is available (for command type)"
          },
          "command": {
            "type": "string",
            "description": "Command to install the skill (for command type)"
          },
          "description": {
            "type": "string",
            "description": "Optional description of the skill"
          }
        },
        "required": ["type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version"],
  "additionalProperties": false
}
